{
  "permissionProfile": {
    "type": "managed",
    "file_system": {
      "type": "restricted",
      "entries": [
        {
          "path": {
            "type": "special",
            "value": {
              "kind": "root"
            }
          },
          "access": "read"
        },
        {
          "path": {
            "type": "path",
            "path": "{workspace}"
          },
          "access": "write"
        },
        {
          "path": {
            "type": "special",
            "value": {
              "kind": "slash_tmp"
            }
          },
          "access": "write"
        },
        {
          "path": {
            "type": "special",
            "value": {
              "kind": "tmpdir"
            }
          },
          "access": "write"
        },
        {
          "path": {
            "type": "path",
            "path": "{workspace}/.git"
          },
          "access": "read",
          "missing_path_behavior": "skip"
        },
        {
          "path": {
            "type": "path",
            "path": "{workspace}/.agents"
          },
          "access": "read",
          "missing_path_behavior": "skip"
        },
        {
          "path": {
            "type": "path",
            "path": "{workspace}/.codex"
          },
          "access": "read",
          "missing_path_behavior": "skip"
        },
        {
          "path": {
            "type": "path",
            "path": "{workspace}/.aws"
          },
          "access": "read",
          "missing_path_behavior": "skip"
        }
      ]
    },
    "network": "restricted"
  },
  "codexLinuxSandboxExe": null,
  "sandboxCwd": "file://{workspace}",
  "useLegacyLandlock": false,
  "useMxc": false
}
